NODE_ENV=local

# `bun run dev` serves named portless `.localhost` URLs (branch-prefixed in a worktree); `PORTLESS=0` uses the plain localhost ports below.

# -------------------- Server variables --------------------

HONO_APP_URL=http://localhost:4000
HONO_HOSTNAME=127.0.0.1 # the dashboard drives local Claude sessions, so it listens on loopback only (default); a container sets 0.0.0.0 and publishes on 127.0.0.1
HONO_TRUSTED_ORIGINS=http://localhost:3000
HONO_RATE_LIMIT=60 # allow 60 req/min (default), twice that for authenticated users and 20 times for an owner's reads
HONO_RATE_LIMIT_WINDOW_MS=60000 # 1 minute (default)

# Generate using `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Optional (local dev only): set to `true` to enable the agent sign-in route (`/api/agents/sign-in-as`), which mints an admin session for AI-agent testing. Leave blank (or `false`) everywhere else, including production; the route stays unmounted.
AGENT_SIGNIN_ENABLED=

# Optional: the Changelog plugin's switch (api/hono/src/plugins/changelog/). Leave blank for its default in `features` (packages/config/src/site.ts, on); `false` makes it inert: its routes 404 and `bun run changelog` writes nothing.
CHANGELOG_ENABLED=

# Optional: people's names and handles, comma-separated, that the Changelog drops from every entry's description and reads as a teammate in its line, as it drops the agents and the owner. Blank means none. Run `bun run changelog seed --refresh-detail` once after setting it, so entries already stored lose the names too.
CHANGELOG_PEOPLE=

# Optional, on a hosted build alone (PLAYGROUND_HOSTED): the GitHub OAuth app's client id and secret, its callback on the web's host, so a member signs in with GitHub. A local stack never offers GitHub.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: set to `true` to let the dashboard answer a session's permission and plan prompts. Off by default: answering one approves another session's action, so it stays off until the dashboard's login is the owner's alone. Picker questions are answered either way.
PLAYGROUND_APPROVALS_ENABLED=

# Optional: set to `true` to show every session on this machine, cmux's included, beside the ones Playground started. Off by default: a stack that reads your machine shows Playground's own sessions alone, on the board, under Sessions and in System, and stores no other transcript, since cmux and other terminals also run sessions Playground never started. Turn it on where cmux runs your factory's sessions; the stack then needs cmux to answer it.
PLAYGROUND_CMUX_SESSIONS=

# Optional: the folder the dashboard keeps its files in outside the database (the roster, attachments, previews, the ops jobs' heartbeats and the rest). Leave blank for `~/.playground`. Read on a stack that reads this machine; a fixture stack keeps to its fixture.
PLAYGROUND_DATA_DIR=

# Optional: the session name the dashboard treats as the first dispatcher, whose chat is the Dashboard's home and holds the Inbox (default the dispatcher's name in `sessions.names`); its composer and the second dispatcher's are the only ones that write to a terminal. A live-reads test stack points it at a throwaway session, so a test never types into the real one.
PLAYGROUND_DISPATCHER=

# Optional: the session name of the second dispatcher, which runs beside the first on another model with its own chat on the Dashboard (default: the first's name plus -2). Left unset, a live-reads test stack's second dispatcher follows its probe (probe-x-2), never the real second dispatcher.
PLAYGROUND_DISPATCHER_SECONDARY=

# Optional: your own clone reads your own machine (its herdr sessions and ~/.claude, and cmux with PLAYGROUND_CMUX_SESSIONS); a worktree under .claude/worktrees/, a session with PLAYGROUND_ROLE and a test run read a fixture, a made-up machine with fake sessions, transcripts, roster, asks and usage, shown under a Test data badge. Set `shipped` to read the shipped fixture (api/hono/src/fixtures/dashboard.json) here too, or name another fixture file (relative to the checkout's root, or absolute). The live dashboard refuses it.
PLAYGROUND_FIXTURE=

# Optional: set to `1` for Playground's hosted build (Yard), never on a stack of your own. The API mounts only sign-in, health and Yard's routes and reads no machine, sign-in offers GitHub, and NEXT_PUBLIC_PLAYGROUND_HOSTED, set with it, turns the web's local pages off. A build without it refuses to serve on Vercel.
PLAYGROUND_HOSTED=

# Optional: set to `true` to read the live machine (its herdr sessions and ~/.claude, and cmux with PLAYGROUND_CMUX_SESSIONS) instead of a fixture, for a probe test of a dashboard write. Such a stack shows real sessions: take no screenshots of it. It refuses PLAYGROUND_FIXTURE.
PLAYGROUND_LIVE_READS=

# Optional, on a fixture stack only: set to `true` for onboarding's made-up missing list (docker and gh missing, uv optional) in place of every row ok, for a shot of its dialog. A stack reading your own machine ignores it.
PLAYGROUND_ONBOARD_MISSING=

# Optional: the name the dashboard calls its owner by, which Next up ranks after fixes (default Owner).
PLAYGROUND_OWNER_NAME=

# Optional: the permission mode the hosted probe-sdk session starts in: acceptEdits, bypassPermissions (the default, as the factory's terminal sessions run), default or plan. The composer's picker changes it while it runs, only while PLAYGROUND_APPROVALS_ENABLED is on.
PLAYGROUND_SDK_PERMISSION_MODE=

# Optional: an existing folder (a scratch checkout under .claude/worktrees/) where the dashboard hosts one throwaway session, probe-sdk, on the Claude Agent SDK, running the installed `claude` on your own login. Leave blank and the dashboard hosts nothing. The session's id is kept in that folder's .sdk-session, so a restart resumes it. A fixture stack may host it too: it is the one real session such a stack runs, opt-in, and its view shows only its own throwaway turns.
PLAYGROUND_SDK_PROBE_DIR=

# Optional: set to `true` to run the Slack integration (off by default).
SLACK_ENABLED=

# Optional: the GitHub organisation your own work lives in. Set it and `bun run queues` also lists your open pull requests there, read from GitHub with `gh` and never written to. Leave blank for no work queue.
WORK_GITHUB_ORG=

# Optional: what the work queue is called in `bun run queues` (default Work).
WORK_LABEL=

# postgres://postgres:<pw>@127.0.0.1:<port>/postgres, from `docker run -d --name playground-<worktree>-db -e POSTGRES_PASSWORD=<pw> -p 127.0.0.1::5432 postgres:alpine` (loopback alone) and `docker port playground-<worktree>-db 5432` for <port>
POSTGRES_URL=

# Optional: redis://127.0.0.1:<port>, from `docker run -d --name playground-<worktree>-redis -p 127.0.0.1::6379 redis:alpine` (loopback alone) and `docker port playground-<worktree>-redis 6379` for <port>. The factory's locks (the merge lock) keep their holder there with a time to live, so a crashed holder's lock lapses by itself; blank, or a Redis that does not answer, keeps them in their lock folders as before. `pr:merge` and `pr:train` run with `bun --no-env-file`, so they take it from their environment alone, never this file; `bun run lock` still reads it here.
REDIS_URL=

# Optional, on a hosted build alone (PLAYGROUND_HOSTED): the Redis URL (rediss://...) Yard's socket fans a message out through, so a post on one instance reaches a member whose socket another instance holds. Blank, each instance reaches only its own sockets, as one local process does.
KV_URL=

# Optional, on a local stack: the hosted Yard this Playground reads and posts to, its API (YARD_API_URL) and its web (YARD_WEB_URL, where a pending post's Approve opens). The Mac's token stays in the Keychain (`playground yard login`). Blank, Yard stays off here and the sidebar shows no Channels or Direct messages.
YARD_API_URL=
YARD_WEB_URL=

# Optional, on a live-reading stack only (a fixture stack keeps them in its fixture): the owner-only directory (0700, each file 0600) the dashboard keeps a message's attachments in, for the session to Read; files leave it a week after they arrive. Leave blank for `attachments` in the dashboard's data folder (PLAYGROUND_DATA_DIR). A live-reads test stack points it at a scratch folder.
PLAYGROUND_ATTACHMENTS_DIR=

# Optional, on a live-reading stack only (a fixture stack keeps them in its fixture): the owner-only directory (0700, each file 0600) the Changelog keeps the screenshots `bun run changelog sync` copies from merged PRs in; they are never swept. Leave blank for `changelog` in the dashboard's data folder (PLAYGROUND_DATA_DIR). A live-reads test stack points it at a scratch folder.
PLAYGROUND_CHANGELOG_DIR=

# Optional, on a live-reading stack only (a fixture stack keeps them in its fixture), and temporary, while a lost paste is chased: the owner-only directory (0700, each file 0600) the dashboard keeps a report in when a dictation misses the message box, the browser's paste log of element names, lengths, delays and clipboard types, never the words; the newest 20 are kept. Leave blank for `debug/paste` in the dashboard's data folder (PLAYGROUND_DATA_DIR). A live-reads test stack points it at a scratch folder.
PLAYGROUND_DEBUG_PASTE_DIR=

# Optional, on a live-reading stack only (a fixture stack reads no herdr server): the directory holding the sockets of the herdr servers the dashboard lists sessions from beside cmux's, each `<name>.sock`. Leave blank for `herdr` in the data folder under `~/.claude`, which follows `HOME` and never `$CLAUDE_CONFIG_DIR` or PLAYGROUND_DATA_DIR, where ops-herdr serves them. A live-reads test stack points it at its own scratch server's folder. ops-herdr reads it too, so a scratch server for both sets this one.
PLAYGROUND_HERDR_DIR=

# Optional, on a live-reading stack only: the herdr servers to read, by name, comma-separated. Leave blank for `playground,playground-probes` plus every other server socket in the folder, such as an older Playground's `factory` and `probes`. A server that is not running is skipped.
PLAYGROUND_HERDR_SESSIONS=

# Optional, on a live-reading stack only (a fixture stack reads its fixture's): the directory the Previews app reads the images and HTML pages agents make for the owner from. Leave blank for `previews` in the dashboard's data folder (PLAYGROUND_DATA_DIR). A live-reads test stack points it at a scratch folder.
PLAYGROUND_PREVIEWS_DIR=

# -------------------- Client variables --------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: set to `1` with PLAYGROUND_HOSTED for the hosted build, where the dashboard's local pages answer 404.
NEXT_PUBLIC_PLAYGROUND_HOSTED=

# Optional: PostHog Analytics (https://zerostarter.dev/docs/manage/analytics)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Optional: User feedback (https://zerostarter.dev/docs/manage/analytics)
NEXT_PUBLIC_USERJOT_URL=
