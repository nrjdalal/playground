{
  "name": "@api/hono",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown && bun build dist/index.mjs --outfile bundle/index.mjs --target bun --minify --env disable && cp dist/scalar.js bundle/scalar.js",
    "build:vercel": "tsdown && bun build dist/hosted.mjs --outfile vercel-bundle/index.mjs --target bun --minify --env disable --external hono",
    "check-types": "tsc --noEmit",
    "dev": "portless",
    "dev:app": "concurrently \"tsdown --watch\" \"bun ../../packages/scripts/src/portless.ts bun --hot src/main.ts\"",
    "serve": "portless --script serve:app",
    "serve:app": "bun ../../packages/scripts/src/portless.ts bun --no-install src/main.ts",
    "start": "bun --no-install bundle/index.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@arcjet/ip": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/standard-validator": "catalog:",
    "@packages/auth": "workspace:*",
    "@packages/config": "workspace:*",
    "@packages/db": "workspace:*",
    "@packages/env": "workspace:*",
    "@packages/message": "workspace:*",
    "@packages/settings": "workspace:*",
    "@scalar/api-reference": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "hono-rate-limiter": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "concurrently": "catalog:",
    "portless": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "portless": {
    "name": "api.playground",
    "script": "dev:app"
  }
}
