{
  "name": "playground",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "api/*",
    "packages/*",
    "web/*"
  ],
  "scripts": {
    "ask": "bun api/hono/src/bin/dashboard-ask.ts",
    "auth:schema": "bun packages/scripts/src/auth-schema.ts",
    "build": "turbo run build --summarize && bun packages/scripts/src/build-sizes.ts",
    "changelog": "bun api/hono/src/plugins/changelog/cli.ts",
    "check-types": "turbo run check-types --summarize && bun run check-types:tests",
    "check-types:tests": "if [ -d tests ]; then find tests -name tsconfig.json -print0 | xargs -0 -n1 tsc -p; fi",
    "ci:go": "bun packages/scripts/src/verify/prebuild.ts pr-merge && bun --no-env-file packages/scripts/src/pr-merge/go-cli.ts",
    "clean": "bun packages/scripts/src/clean.ts",
    "console:roles": "bun packages/scripts/src/console-roles.ts",
    "db:generate": "turbo run build --filter=@packages/env && bun --cwd packages/db drizzle-kit generate",
    "db:migrate": "turbo run build --filter=@packages/env && bun --cwd packages/db drizzle-kit migrate",
    "db:studio": "turbo run build --filter=@packages/env && bun --cwd packages/db drizzle-kit studio",
    "dev": "bun --no-env-file api/hono/src/bin/dev-running.ts start && bun --no-env-file packages/scripts/src/verify/prebuild.ts api && bun --no-env-file api/hono/src/bin/dev.ts",
    "dev:stop": "bun --no-env-file api/hono/src/bin/dev-stop.ts",
    "devtools": "turbo devtools",
    "docs:wrap": "bun packages/scripts/src/docs-wrap/cli.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "ingest": "bun api/hono/src/bin/dashboard-ingest.ts",
    "linear:read": "bun --no-env-file packages/scripts/src/linear-read/cli.ts",
    "lint": "oxlint",
    "lock": "bun packages/scripts/src/lock/cli.ts",
    "loom-relay": "bun --no-env-file packages/scripts/src/loom-relay/cli.ts",
    "name": "bun packages/scripts/src/name/index.ts",
    "ops:ext-sync": "bun packages/scripts/src/ops-ext-sync/cli.ts",
    "ops:flow": "bun packages/scripts/src/ops-flow/cli.ts",
    "ops:herdr": "bun --no-env-file packages/scripts/src/ops-herdr/cli.ts",
    "ops:machine": "bun packages/scripts/src/ops-machine/cli.ts",
    "ops:outbox": "bun packages/scripts/src/ops-outbox/drain.ts",
    "ops:session-resume": "bun packages/scripts/src/ops-session-resume/cli.ts",
    "ops:sweep": "bun --no-env-file packages/scripts/src/ops-sweep/cli.ts",
    "ops:tick": "bun packages/scripts/src/ops-tick/cli.ts",
    "ops:zai-usage": "bun packages/scripts/src/ops-zai-usage/cli.ts",
    "postinstall": "bun packages/scripts/src/deps-manager.ts",
    "prepare": "bunx lefthook install",
    "parity": "bun packages/scripts/src/parity/cli.ts",
    "pr:merge": "bun packages/scripts/src/verify/prebuild.ts pr-merge && bun --no-env-file packages/scripts/src/pr-merge/cli.ts",
    "pr:train": "bun packages/scripts/src/verify/prebuild.ts pr-merge && bun --no-env-file packages/scripts/src/pr-merge/train-cli.ts",
    "queues": "bun api/hono/src/bin/dashboard-queues.ts",
    "rename": "bun packages/scripts/src/rename/cli.ts",
    "shadcn:update": "bun packages/scripts/src/shadcn-update.ts && bun i",
    "stamp": "bun --no-env-file packages/scripts/src/pr-merge/stamp-cli.ts",
    "start": "turbo run start",
    "test": "if [ -d tests ]; then turbo run build --filter='./packages/*' && bun packages/scripts/src/env-keys.ts && bun packages/scripts/src/data-table-metrics.ts && NODE_ENV=test bun packages/scripts/src/test-sandbox.ts; fi",
    "test:e2e": "[ ! -d tests ] || E2E_API_URL=${E2E_API_URL:-http://localhost:4000} E2E_WEB_URL=${E2E_WEB_URL:-http://localhost:3000} bun run test:file e2e.test",
    "test:file": "NODE_ENV=test bun packages/scripts/src/test-sandbox.ts",
    "test:skills": "bun packages/scripts/src/test-skills.ts",
    "test:timings": "TEST_TIMINGS_UPDATE=1 bun run test",
    "thread": "bun api/hono/src/bin/dashboard-thread.ts",
    "trace-count": "bun packages/scripts/src/trace-count/cli.ts",
    "vendor:upstream": "bun packages/scripts/src/vendor-upstream/cli.ts",
    "verify": "bun packages/scripts/src/verify/prebuild.ts && bun packages/scripts/src/verify/cli.ts",
    "wispr:latest": "bun packages/scripts/src/wispr/latest.ts"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-syntax-typescript": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@lat.md/core": "catalog:",
    "@octokit/rest": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@viz-js/viz": "catalog:",
    "globby": "catalog:",
    "lefthook": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "portless": "catalog:",
    "sharp": "catalog:",
    "svgo": "catalog:",
    "ts-morph": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "seroval": "^1.6.8",
    "shell-quote": "^1.11.0",
    "toml": "^5.0.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "bun@1.4.3",
  "catalog": {
    "@ai-sdk/react": "^4.0.131",
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@arcjet/ip": "^1.14.1",
    "@babel/core": "^7.29.7",
    "@babel/plugin-syntax-typescript": "^7.29.7",
    "@base-ui/react": "^1.9.0",
    "@chenglou/pretext": "^1.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^2.1.5",
    "@hono/standard-validator": "^0.4.0",
    "@lat.md/core": "^0.1.3",
    "@octokit/rest": "^22.0.1",
    "@remixicon/react": "^4.9.0",
    "@scalar/api-reference": "^1.73.0",
    "@scalar/hono-api-reference": "^0.12.14",
    "@shadcn/react": "^0.3.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@takumi-rs/core-darwin-arm64": "^2.17.1",
    "@takumi-rs/core-darwin-x64": "^2.17.1",
    "@takumi-rs/core-linux-arm64-gnu": "^2.17.1",
    "@takumi-rs/core-linux-arm64-musl": "^2.17.1",
    "@takumi-rs/core-linux-x64-gnu": "^2.17.1",
    "@takumi-rs/core-linux-x64-musl": "^2.17.1",
    "@takumi-rs/core-win32-arm64-msvc": "^2.17.1",
    "@takumi-rs/core-win32-x64-msvc": "^2.17.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@types/bun": "^1.4.4",
    "@types/fontkit": "^2.0.9",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vercel/speed-insights": "^2.0.0",
    "@viz-js/viz": "^3.31.0",
    "ai": "^7.0.128",
    "auth": "^1.7.12",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-auth": "^1.7.12",
    "changelogen": "^0.6.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "entities": "^8.1.0",
    "fontkit": "^2.0.4",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.8",
    "globby": "^16.2.4",
    "hono": "^4.13.13",
    "hono-openapi": "^1.5.0",
    "hono-rate-limiter": "^0.5.4",
    "input-otp": "^1.5.0",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.3",
