{
  "$schema": "https://turborepo.com/schema.json",
  // turbo 2.11.5 writes a managed block into AGENTS.md when it detects an agent; this repo generates that file and forks inherit it whole, so a second writer would fight both. Off here, as Next's writer is in web/next/next.config.ts
  "agentGuidance": false,
  // Each checkout caches inside itself, so a worktree never shares the main checkout's .turbo/cache, which every installed skill follows and must stay clean; the pre-commit hook points TURBO_CACHE_DIR at one folder outside every checkout instead
  "cacheDir": ".turbo/cache",
  "tasks": {
    // the root version is baked into this build (BUILD_VERSION), so a version-only commit must miss its cache; the apps rebuild behind it through their dependency hashes
    "@packages/env#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json"],
      "outputs": ["dist/**"]
    },
    // @packages/scripts has no build script, but its build task's hash reaches every workspace that depends on it (web and auth run its generators in their builds) through ^build; hashing only the generators keeps a stale build from a generator edit out of the cache, while an edit to any other script (pr-merge, hooks, ops jobs) leaves every build's cache whole (tests/turbo.test.ts keeps this list whole)
    "@packages/scripts#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/compress-images.ts",
        "src/data-table-metrics.ts",
        "src/docs.ts",
        "src/generate-env.ts"
      ]
    },
    // @packages/scripts imports these files by relative path from outside every package's folder, which turbo's change filter never maps to it, since it selects packages by folder alone: the type gates name it with --filter=@packages/scripts, and these inputs make that run miss the cache when one of them changed, so its tsc runs; tests/turbo.test.ts keeps this list whole
    "@packages/scripts#check-types": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/api/hono/src/lib/dashboard/delete-targets.ts",
        "$TURBO_ROOT$/api/hono/src/lib/dev/live-dashboard.ts",
        "$TURBO_ROOT$/api/hono/src/lib/dev/proxy.ts",
        "$TURBO_ROOT$/api/hono/src/lib/dev/stop.ts",
        "$TURBO_ROOT$/api/hono/src/lib/keychain-items.ts",
        "$TURBO_ROOT$/api/hono/src/lib/keychain.ts",
        "$TURBO_ROOT$/api/hono/src/lib/usage/prices.ts",
        "$TURBO_ROOT$/api/hono/src/lib/yard/client.ts",
        "$TURBO_ROOT$/api/hono/src/lib/yard/keychain.ts",
        "$TURBO_ROOT$/scripts/hooks/**/*.ts",
        "$TURBO_ROOT$/scripts/ops/optimizer/*.ts",
        "$TURBO_ROOT$/scripts/roster-statuses.json",
        "$TURBO_ROOT$/web/next/docs.config.ts",
        "$TURBO_ROOT$/web/next/src/lib/agent-label.ts",
        "$TURBO_ROOT$/web/next/src/lib/blog-policy.ts",
        "$TURBO_ROOT$/web/next/src/lib/docs.ts",
        "$TURBO_ROOT$/web/next/src/lib/model-label.ts",
        "$TURBO_ROOT$/web/next/src/lib/tooltip.ts",
        "$TURBO_ROOT$/web/next/src/lib/verify-visit.ts"
      ]
    },
    // web's build also writes .generated/ at the repo root, which a bare check-types:tests reads, so a cached replay restores it too; it waits for web's check-types, whose tsc reads the .next/types next build deletes and rewrites
    "@web/next#build": {
      "dependsOn": ["^build", "check-types"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".source/**",
        "bundle/**",
        "dist/**",
        "$TURBO_ROOT$/.generated/data-table-metrics.json",
        "$TURBO_ROOT$/.generated/web-env.json"
      ]
    },
    // web's dev builds its workspace packages but not @api/hono, whose own dev task watches the dist a build would clean under it (web imports only its types); tests/api/hono/src/bin/dev.test.ts keeps this list whole
    "@web/next#dev": {
      "dependsOn": ["@packages/auth#build", "@packages/config#build", "@packages/env#build"],
      "passThroughEnv": ["GIT_SHA"],
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".source/**",
        "bundle/**",
        "dist/**"
      ]
    },
    "build:vercel": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".source/**",
        "dist/**",
        "vercel-bundle/**"
      ]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      // the launcher (api/hono/src/bin/dev.ts) sets HEAD's sha, which /api/health reports over the one baked into a cached @packages/env build; passed through rather than hashed, so a commit costs no cache
      "passThroughEnv": ["GIT_SHA"],
      "persistent": true,
      "cache": false
    },
    // the live dashboard's production stack: each app serves the build the supervisor kept (PLAYGROUND_BUILD), so nothing builds first
    "serve": {
      "passThroughEnv": ["GIT_SHA", "PLAYGROUND_BUILD"],
      "persistent": true,
      "cache": false
    },
    "start": {
      "persistent": true,
      "cache": false
    }
  },
  "globalDependencies": [".env*"],
  "globalEnv": [
    // CI variables
    "SKIP_ENV_VALIDATION",
    "SKIP_ENV_VALIDATION_SERVER",
    // Server variables
    "NODE_ENV",
    "BETTER_AUTH_SECRET",
    "CHANGELOG_ENABLED",
    "CHANGELOG_PEOPLE",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "HONO_APP_URL",
    "HONO_HOSTNAME",
    "HONO_PORT",
    "HONO_RATE_LIMIT",
    "HONO_RATE_LIMIT_WINDOW_MS",
    "HONO_TRUSTED_ORIGINS",
    "HONO_WEB_URL",
    "INTERNAL_API_URL",
    "KV_URL",
    "PLAYGROUND_ALL_SESSIONS",
    "PLAYGROUND_APPROVALS_ENABLED",
    "PLAYGROUND_DISPATCHER",
    "PLAYGROUND_DISPATCHER_SECONDARY",
    "PLAYGROUND_HOSTED",
    "PLAYGROUND_SDK_PERMISSION_MODE",
    "PLAYGROUND_SDK_PROBE_DIR",
    "POSTGRES_URL",
    "REDIS_URL",
    "YARD_API_URL",
    "YARD_WEB_URL",
    // Client variables
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_PLAYGROUND_HOSTED",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN",
    "NEXT_PUBLIC_USERJOT_URL"
  ],
  // CLAUDECODE, PLAYGROUND_FIXTURE, PLAYGROUND_FIXTURE_DIR, PLAYGROUND_LIVE_READS and PLAYGROUND_ROLE are read straight from the environment by the dashboard's source (api/hono/src/lib/dashboard/fixture.ts), so an exported one reaches the API as it reaches the dev launcher, and the API chooses the source the launcher checked (a factory session's role, or Claude Code with none), which writes the fixture the API then reads, and PLAYGROUND_FIXTURE_LAUNCHED is the launcher's word to its stack that it wrote that fixture; the organisation's config (packages/config/src/org.ts: PLAYGROUND_DATA_DIR, PLAYGROUND_OWNER_NAME, WORK_GITHUB_ORG and WORK_LABEL) is read straight from the environment too, and so is each live-reads stack's scratch path, by its reader: PLAYGROUND_ATTACHMENTS_DIR by the dashboard's attachments (api/hono/src/lib/dashboard/attachments.ts), which the transcript parser reads too, PLAYGROUND_CHANGELOG_DIR by the Changelog's screenshots (api/hono/src/plugins/changelog/images.ts), PLAYGROUND_DEBUG_PASTE_DIR by the composer's temporary debug report (api/hono/src/lib/dashboard/debug-report.ts), PLAYGROUND_HERDR_DIR and PLAYGROUND_HERDR_SESSIONS by the dashboard's herdr provider (api/hono/src/lib/dashboard/herdr.ts), PLAYGROUND_MERGED_PULLS by the merged pull requests' cache (api/hono/src/lib/dashboard/agents.ts), PLAYGROUND_PREVIEWS_DIR by the Previews app (api/hono/src/lib/apps/previews.ts), and PLAYGROUND_PROFILE_URL by a Claude account's profile read (api/hono/src/lib/accounts/claude-setup.ts); each old name the DESK_* wildcard passes still reads (packages/env/src/aliases.ts); PLAYGROUND_BARE_NAMES is the dev launcher's word to the live dashboard's apps that the bare names are theirs too (packages/scripts/src/portless.ts), and PORTLESS_STATE_DIR keeps portless in the apps on the routes the launcher read; PLAYGROUND_ONBOARD_MISSING is read by onboarding's checks on a fixture stack alone (api/hono/src/lib/onboard/checks.ts); PLAYGROUND_HERDR_SESSION, PLAYGROUND_LOAD_MULT and PLAYGROUND_REPO are spawn.sh's own reads (the herdr server a spawn opens on, its load gate's multiplier, the main checkout its code root and leads worktree sit on), passed so a value the stack's starter exports reaches the API task, whose session starts hand their spawn env, this list's names and the .env's PLAYGROUND_* names included, to every spawn.sh they run (tests/turbo.test.ts keeps spawn.sh's reads on these lists), NEXT_TELEMETRY_DISABLED is the 1 the dev launcher sets for next dev, whose telemetry flush can otherwise outlive the stack and hold the worktree's files, and TMPDIR keeps a task's temp folder the caller's own, since without it a tool's os.tmpdir() falls back to /tmp, which Claude Code's sandbox gives a shell no write to
  "globalPassThroughEnv": [
    "CLAUDECODE",
    "DESK_*",
    "NEXT_TELEMETRY_DISABLED",
    "PLAYGROUND_ATTACHMENTS_DIR",
    "PLAYGROUND_BARE_NAMES",
    "PLAYGROUND_CHANGELOG_DIR",
    "PLAYGROUND_DATA_DIR",
    "PLAYGROUND_DEBUG_PASTE_DIR",
    "PLAYGROUND_FIXTURE",
    "PLAYGROUND_FIXTURE_DIR",
    "PLAYGROUND_FIXTURE_LAUNCHED",
    "PLAYGROUND_HERDR_DIR",
    "PLAYGROUND_HERDR_SESSION",
    "PLAYGROUND_HERDR_SESSIONS",
    "PLAYGROUND_LIVE_READS",
    "PLAYGROUND_LOAD_MULT",
    "PLAYGROUND_MERGED_PULLS",
    "PLAYGROUND_ONBOARD_MISSING",
    "PLAYGROUND_OWNER_NAME",
    "PLAYGROUND_PREVIEWS_DIR",
    "PLAYGROUND_PROFILE_URL",
    "PLAYGROUND_REPO",
    "PLAYGROUND_ROLE",
    "PORTLESS",
    "PORTLESS_HTTPS",
    "PORTLESS_PORT",
    "PORTLESS_STATE_DIR",
    "PORTLESS_SYNC_HOSTS",
    "TMPDIR",
    "WORK_GITHUB_ORG",
    "WORK_LABEL"
  ]
}
