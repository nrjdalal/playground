{
  "name": "@web/next",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "rm -rf .next/dev/types && bun ../../packages/scripts/src/generate-env.ts web && bun ../../packages/scripts/src/compress-images.ts && bun ../../packages/scripts/src/docs.ts --strict && bun ../../packages/scripts/src/data-table-metrics.ts && fumadocs-mdx && next build",
    "build:vercel": "bun run --bun build",
    "check-types": "rm -rf .next/dev/types && next typegen && bun ../../packages/scripts/src/docs.ts && bun ../../packages/scripts/src/data-table-metrics.ts && fumadocs-mdx && tsc --noEmit",
    "dev": "portless",
    "dev:app": "bun ../../packages/scripts/src/docs.ts && bun ../../packages/scripts/src/data-table-metrics.ts && bun ../../packages/scripts/src/portless.ts next dev --hostname 127.0.0.1",
    "serve": "portless --script serve:app",
    "serve:app": "bun ../../packages/scripts/src/portless.ts sh -c 'HOSTNAME=127.0.0.1 exec bun \"$PLAYGROUND_BUILD/web/web/next/server.js\"'",
    "start": "HOSTNAME=127.0.0.1 bun .next/standalone/web/next/server.js"
  },
  "dependencies": {
    "@ai-sdk/react": "catalog:",
    "@api/hono": "workspace:*",
